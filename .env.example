# Select the Compose configuration to use.
COMPOSE_FILE=docker-compose.local.yml

# JSON array of IMAP accounts. Keep real credentials only in your ignored .env.
# MAIL_ACCOUNTS_JSON='[{"email":"you@example.com","password":"app-password"}]'
MAIL_ACCOUNTS_JSON=[]

# Set true to anonymize email addresses in generated exports.
SECURE=false

# Set true to keep HTML in message bodies. By default bodies are exported as plain text.
KEEP_HTML=false
